PORT=4000
# Required: MongoDB is the primary persistent database
MONGO_URI=mongodb://127.0.0.1:27017/cornercup
# Optional: Redis is used only as a menu cache. Leave blank to run without Redis.
REDIS_URL=
STAFF_PASSWORD=choose-a-strong-password
JWT_SECRET=choose-a-long-random-string
CORS_ORIGIN=http://localhost:5173
